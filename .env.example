# All LLM nodes use the Eastmoney API. MiniLM classification remains local.
# EM_API_KEY can also be configured in the system environment.
EM_API_KEY=
EM_API_BASE_URL=https://dd-ai-api.eastmoney.com/coding/v1
EM_MODEL=DeepSeek-V4-Flash-0731
NEWS_CONTENT_MAX_CHARS=5000

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_THINKING_MODE=disabled
LLM_REQUESTS_PER_MINUTE=27

# Optional: similarity defaults to the classifier's training threshold (~0.6543).
# CATEGORY_MIN_SIMILARITY=0.6542854905128479
# Below the threshold: independent LLM proposal across 82 topics, then LLM verification.
# Dual categories require both Top-2 candidates to pass this threshold and LLM verification.
CATEGORY_DUAL_MAX_GAP=0.005

# Optional local MiniLM directory. When omitted, Hugging Face downloads/caches it.
# SEARCH_INTENT_EMBEDDING_MODEL=C:/path/to/paraphrase-multilingual-MiniLM-L12-v2
CLASSIFIER_WARMUP=true
